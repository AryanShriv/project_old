PORT=4000
NODE_ENV=development
MONGODB_URI=mongodb://localhost:27017/project_old
JWT_ACCESS_SECRET=replace_with_strong_secret
JWT_REFRESH_SECRET=replace_with_strong_secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change_me
ADMIN_NAME=Platform Admin

# Transactional email via Resend (https://resend.com). Leave empty in dev to log emails instead.
RESEND_API_KEY=
EMAIL_FROM="G(Old) <hello@your-verified-domain.com>"
# Email verification is enforced only once RESEND_API_KEY is set. Uncomment to force it on or off.
# REQUIRE_EMAIL_VERIFICATION=true
